# Node 24. Copy to .env.local for Next.js AND .env for the CLI/worker.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER / WORKER ONLY. Never use a NEXT_PUBLIC prefix for this secret.
SUPABASE_SERVICE_ROLE_KEY=
DAILY_EXPORT_CAP=10
RENDER_CONCURRENCY=2
RETENTION_DAYS=30
# Paid plans are enabled by default. Use 0 only for a deliberately free beta.
DEMOPOP_BILLING_ENABLED=1
# Canonical public origin, e.g. https://demopop.example (no trailing path).
APP_ORIGIN=
# Server only. Create a $29 USD one-time price and a $79 USD monthly price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PACKAGE_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
# Optional dedicated customer portal configuration created by billing:setup.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional endpoint ID lets billing:check verify webhook URL, mode and events.
STRIPE_WEBHOOK_ENDPOINT_ID=
PAID_DAILY_EXPORT_CAP=100
